{
  "name": "riftmind",
  "version": "1.0.0",
  "private": true,
  "description": "RiftMind — Assistente Pessoal Local de Draft, Builds e Estratégia para League of Legends (100% Isolado / Compatível com Riot Vanguard)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,magenta \"tsx watch server/index.ts\" \"vite --host 127.0.0.1 --port 5173\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "sync": "tsx server/cli-sync.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts --prod",
    "start:prod": "tsx server/index.ts --prod",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/express": "^5.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
